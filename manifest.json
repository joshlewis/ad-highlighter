{
  "manifest_version": 3,
  "name": "Ad Highlighter",
  "version": "1.1.0",
  "description": "Paints ads bright yellow, or a color you pick, so you can tell at a glance what is an ad and what isn't.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Ad Highlighter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/core.js", "src/color.js", "src/page-color.js", "src/sites/x.js"],
      "css": ["src/highlight.css", "src/sites/x.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["src/core.js", "src/color.js", "src/page-color.js", "src/sites/facebook.js"],
      "css": ["src/highlight.css", "src/sites/facebook.css"],
      "run_at": "document_idle"
    }
  ]
}
